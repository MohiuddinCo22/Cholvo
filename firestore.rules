rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.email == 'admin@cholvo.com';
    }
    function approvedMerchant() {
      return request.auth != null
        && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
        && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.blocked == false;
    }
    function okStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    // Rider snapshot on an order: all five fields together, or none. Written by admin only.
    function riderOk(d) {
      return !d.keys().hasAny(['riderId', 'riderName', 'riderPhone', 'riderAssignedAt', 'riderAssignedBy'])
        || (d.keys().hasAll(['riderId', 'riderName', 'riderPhone', 'riderAssignedAt', 'riderAssignedBy'])
            && d.riderId is string && d.riderId.size() > 0 && d.riderId.size() <= 60
            && d.riderName is string && d.riderName.size() > 0 && d.riderName.size() <= 120
            && d.riderPhone is string && d.riderPhone.matches('^01[0-9]{9}$')
            && d.riderAssignedAt is timestamp
            && d.riderAssignedBy == request.auth.token.email);
    }
    // Merchant cancel: own order, approved merchant, status still before On the Way (checked on the stored order)
    function merchantMayCancel(tn) {
      return approvedMerchant()
        && get(/databases/$(database)/documents/orders/$(tn)).data.merchantUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(tn)).data.status in ['Order Received', 'Picked Up'];
    }
    function validTn(tn) {
      return tn.matches('^CHV-[A-HJ-NP-Z2-9]{6}$');
    }

    // Public tracking: status only. Can be created only together with its order.
    match /tracking/{tn} {
      allow get: if true;
      allow list, delete: if admin();
      // A merchant may cancel its own delivery only before it is On the Way (same batch as the order update)
      allow update: if admin()
        || (merchantMayCancel(tn)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'Cancelled'
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/orders/$(tn)).data.status == 'Cancelled');
      allow create: if validTn(tn)
        && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.keys().hasAll(['status', 'updatedAt'])
        && request.resource.data.status == 'Order Received'
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(tn));
    }

    // Orders: guests and approved merchants create; admin manages; a merchant reads only own.
    match /orders/{tn} {
      function validOrder(d) {
        return d.keys().hasAll(['tn', 'type', 'status', 'merchantUid', 'createdAt'])
          && d.keys().hasOnly(['tn', 'type', 'status', 'merchantUid', 'createdAt',
               'vendor', 'phone', 'pickup', 'drop', 'customerName', 'customerPhone',
               'ptype', 'cod', 'date', 'later', 'name', 'addr', 'product', 'from',
               'hasVoice', 'photoCount'])
          && validTn(tn)
          && d.tn == tn
          && d.status == 'Order Received'
          && d['type'] in ['book', 'order']
          && d.createdAt == request.time
          && okStr(d, 'vendor', 120) && okStr(d, 'phone', 30)
          && okStr(d, 'pickup', 300) && okStr(d, 'drop', 300)
          && okStr(d, 'customerName', 120) && okStr(d, 'customerPhone', 30)
          && okStr(d, 'ptype', 30) && okStr(d, 'date', 40) && okStr(d, 'later', 40)
          && okStr(d, 'name', 120) && okStr(d, 'addr', 300)
          && okStr(d, 'product', 300) && okStr(d, 'from', 300)
          && (!('cod' in d) || (d.cod is number && d.cod >= 0 && d.cod <= 10000000))
          // voice/photo orders: the files themselves go to Telegram, only these two flags are stored
          && (!('hasVoice' in d) || d.hasVoice is bool)
          && (!('photoCount' in d) || (d.photoCount is int && d.photoCount >= 0 && d.photoCount <= 3));
      }
      allow create: if validOrder(request.resource.data)
        && (request.resource.data.merchantUid == null
            || (request.auth != null
                && request.resource.data.merchantUid == request.auth.uid
                && approvedMerchant()));
      allow read: if admin()
        || (approvedMerchant() && resource.data.merchantUid == request.auth.uid);
      allow update: if (admin() && riderOk(request.resource.data))
        || (merchantMayCancel(tn)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledBy'])
            && request.resource.data.status == 'Cancelled'
            && request.resource.data.cancelledBy == 'merchant'
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/tracking/$(tn)).data.status == 'Cancelled');
      allow delete: if admin();
    }

    // Riders: admin only. Never readable by merchants or the public.
    match /riders/{id} {
      allow read, write: if admin();
    }

    match /merchants/{uid} {
      allow create: if admin();
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list, update, delete: if admin();
    }

    // One registration per mobile number: the request's document id IS the number, so a second request
    // with the same number cannot be created. It is always written together with its phoneIndex entry.
    match /merchantRequests/{id} {
      allow create: if request.resource.data.status == 'pending'
        && id == request.resource.data.mobile
        && existsAfter(/databases/$(database)/documents/phoneIndex/$(id))
        && request.resource.data.keys().hasOnly(['businessName', 'ownerFirst', 'ownerLast',
             'businessType', 'branches', 'email', 'mobile', 'businessPhone', 'samePhone',
             'agreed', 'status', 'createdAt'])
        && request.resource.data.businessType in ['Shop', 'Restaurant']
        && request.resource.data.mobile.matches('^01[0-9]{9}$')
        && request.resource.data.agreed == true
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.createdAt == request.time
        && okStr(request.resource.data, 'ownerFirst', 80)
        && okStr(request.resource.data, 'ownerLast', 80)
        && okStr(request.resource.data, 'email', 120)
        && okStr(request.resource.data, 'businessPhone', 30)
        && (!('branches' in request.resource.data) || request.resource.data.branches is number);
      allow read, update, delete: if admin();
    }

    // Lets the registration form say "already existing". Guests can only check one number (get), never list them.
    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if admin();
      allow create: if admin()
        || (phone.matches('^01[0-9]{9}$')
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time
            && existsAfter(/databases/$(database)/documents/merchantRequests/$(phone)));
      allow update, delete: if admin();
    }

    // Merchant App banners: only the list lives here (the pictures are files in the website repo's banners/ folder)
    match /banners/{id} {
      function validBanner(d) {
        return d.keys().hasOnly(['file', 'title', 'order', 'active', 'createdAt'])
          && d.keys().hasAll(['file', 'order', 'active', 'createdAt'])
          && d.file is string && d.file.matches('^banner-[a-z0-9]{8}[.]jpg$')
          && (!('title' in d) || (d.title is string && d.title.size() <= 80))
          && d.order is int && d.order >= 0 && d.order <= 999
          && d.active is bool
          && d.createdAt is timestamp;
      }
      allow read: if admin() || approvedMerchant();
      allow create, update: if admin() && validBanner(request.resource.data);
      allow delete: if admin();
    }

    // Notifications sent by the admin to all merchants (shown under the bell in the Merchant App)
    match /notifications/{id} {
      allow read: if admin() || approvedMerchant();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow delete: if admin();
    }

    // Forgot password: the merchant app creates a request (random unguessable id, kept on the merchant's phone).
    // The admin approves or rejects it. The new password itself is set by the /api/reset-password function
    // (server side), which only accepts an approved, unused, not-expired request.
    match /passwordResets/{rid} {
      allow create: if rid.matches('^[A-Za-z0-9]{32}$')
        && request.resource.data.keys().hasOnly(['phone', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[0-9]{9}$')
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/phoneIndex/$(request.resource.data.phone));
      // get only (never list): the id is a secret, so only the device that made the request can follow it
      allow get: if true;
      allow list, delete: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedAt == request.time
        && resource.data.status == 'pending';
    }

    match /private/{doc} {
      allow read: if admin() || approvedMerchant();
      allow write: if admin();
    }
  }
}
